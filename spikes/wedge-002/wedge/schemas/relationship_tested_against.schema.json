{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relationship_tested_against.schema.json",
  "title": "tested_against relationship record (Part | Assembly → TestProcedure; per ADR/0021)",
  "type": "object",
  "required": ["id", "type", "binding", "endpoints"],
  "additionalProperties": false,
  "properties": {
    "id":       { "type": "string", "pattern": "^rel_[a-z0-9_]+$" },
    "name":     { "type": "string", "minLength": 1 },
    "type":     { "const": "tested_against" },
    "binding":  { "enum": ["float", "fixed"] },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["object_uuid"],
        "additionalProperties": false,
        "properties": {
          "object_uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "revision_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
        }
      }
    },
    "fact_provenance": {
      "type": "object",
      "required": ["category"],
      "additionalProperties": false,
      "properties": {
        "category":      { "enum": ["human_input", "ai_proposal", "computed_result", "measured"] },
        "ai_agent_ref":  { "type": "string" },
        "derived_from":  { "type": "array", "items": { "type": "string" } }
      }
    },
    "fact_uncertainty": { "enum": ["verified", "requires_validation", "computed", "estimated"] }
  },
  "allOf": [
    {
      "if":   { "properties": { "binding": { "const": "fixed" } }, "required": ["binding"] },
      "then": { "properties": { "endpoints": { "items": { "required": ["object_uuid", "revision_id"] } } } }
    }
  ]
}
