{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Release Manifest (Wedge-001 spike-grade per ADR/0023 + ADR/0009 + ADR/0001 + ADR/0003)",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "manifest_type", "release_label", "released_at", "revisions", "validation_outcomes", "event_log_boundary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artifact_kind":  { "const": "manifest" },
    "manifest_type":  { "const": "release" },
    "release_label":  { "type": "string", "minLength": 1 },
    "released_at":    { "type": "string", "format": "date-time" },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["object_uuid", "object_number", "revision_id", "revision_hash"],
        "additionalProperties": false,
        "properties": {
          "object_uuid":   { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "object_number": { "type": "string", "pattern": "^(P|REQ)-[0-9]{6}$" },
          "revision_id":   { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "revision_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "validation_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_name", "result", "details"],
        "additionalProperties": false,
        "properties": {
          "check_name": { "type": "string", "minLength": 1 },
          "result":     { "enum": ["PASS", "FAIL"] },
          "details":    { "type": "string" }
        }
      }
    },
    "event_log_boundary": {
      "type": "object",
      "required": ["last_event_id", "last_event_hash"],
      "additionalProperties": false,
      "properties": {
        "last_event_id":   { "type": "string", "pattern": "^evt_[0-9]{4}$" },
        "last_event_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
