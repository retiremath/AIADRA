{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance criterion item shape (shared across Requirement sidecar/Revision + requirement_changed event per ADR/0006 + ADR/0025 §5 + Phase 4 F2 SCN arc 20260531-5)",
  "type": "object",
  "required": ["id", "criterion"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ac_[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "criterion": {
      "type": "object",
      "required": ["text", "language", "format"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2},
        "format": {"enum": ["freeform", "ears"]}
      }
    },
    "references": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verification_method": {
      "enum": ["test", "analysis", "inspection", "demonstration"]
    },
    "fact_provenance": {
      "type": "object",
      "required": ["category"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": ["human_input", "ai_proposal", "computed_result", "measured"]
        },
        "ai_agent_ref": {"type": "string"},
        "derived_from": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "fact_uncertainty": {
      "enum": ["verified", "requires_validation", "computed", "estimated"]
    },
    "threshold_expression": {
      "type": "object",
      "required": ["parameter_ref", "comparison_op", "value", "unit"],
      "additionalProperties": false,
      "properties": {
        "parameter_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:parameter:param_[a-z0-9_]+$"
        },
        "comparison_op": {
          "enum": [">=", "<=", "==", "!=", ">", "<"]
        },
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      },
      "description": "Per ADR/0025 §5 F2 absorption (arc 20260531-5): optional structured threshold primitive. Numeric-only; unit REQUIRED; no free-text parsing. At release, Layer-2 validator structurally evaluates comparison + emits `threshold_check(<criterion_id>)` PASS/FAIL outcome. FAIL becomes hard-fail at release if a `satisfies` or `verifies` relationship claims the criterion. Unit-equality vs referenced parameter's unit is Layer-2 hard-fail at release (no silent conversion)."
    }
  }
}
