{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestProcedure sidecar / Revision (Wedge-002 spike-grade subset per ADR/0020)",
  "type": "object",
  "required": [
    "object",
    "test_procedure",
    "attachment"
  ],
  "additionalProperties": false,
  "properties": {
    "object": {
      "type": "object",
      "required": [
        "uuid",
        "number",
        "type",
        "name",
        "lifecycle",
        "schema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "number": {
          "type": "string",
          "pattern": "^TST-[0-9]{6}$"
        },
        "type": {
          "const": "TestProcedure"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": [
            "in_work",
            "released"
          ]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision_label": {
          "type": "string",
          "minLength": 1
        },
        "released_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "released"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "required": [
              "revision_id",
              "revision_label",
              "released_at"
            ]
          }
        }
      ]
    },
    "test_procedure": {
      "type": "object",
      "required": [
        "title",
        "verification_method"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "verification_method": {
          "enum": [
            "test",
            "analysis",
            "inspection",
            "demonstration"
          ]
        },
        "applicability_summary": {
          "type": "string",
          "minLength": 1
        },
        "expected_outputs_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "value",
          "datatype"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^param_[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "value": {
            "type": "number"
          },
          "datatype": {
            "enum": [
              "number"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "fact_provenance": {
            "$ref": "#/$defs/fact_provenance"
          },
          "fact_uncertainty": {
            "$ref": "#/$defs/fact_uncertainty"
          }
        }
      }
    },
    "attachment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../_shared/attachment_record.schema.json"
      }
    },
    "relationship": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"]
      }
    }
  },
  "$defs": {
    "fact_provenance": {
      "type": "object",
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "human_input",
            "ai_proposal",
            "computed_result",
            "measured"
          ]
        },
        "ai_agent_ref": {
          "type": "string"
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fact_uncertainty": {
      "enum": [
        "verified",
        "requires_validation",
        "computed",
        "estimated"
      ]
    }
  }
}
