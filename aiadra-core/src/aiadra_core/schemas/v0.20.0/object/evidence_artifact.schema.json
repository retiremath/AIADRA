{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceArtifact sidecar / Revision (Wedge-002 spike-grade subset per ADR/0019)",
  "type": "object",
  "required": [
    "object",
    "evidence",
    "attachment",
    "parameter"
  ],
  "additionalProperties": false,
  "properties": {
    "object": {
      "type": "object",
      "required": [
        "uuid",
        "number",
        "type",
        "name",
        "lifecycle",
        "schema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "number": {
          "type": "string",
          "pattern": "^EVD-[0-9]{6}$"
        },
        "type": {
          "const": "EvidenceArtifact"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": [
            "in_work",
            "released"
          ]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision_label": {
          "type": "string",
          "minLength": 1
        },
        "released_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "released"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "required": [
              "revision_id",
              "revision_label",
              "released_at"
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "summary",
        "evidence_kind"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "enum": [
            "simulation",
            "test_report",
            "measurement",
            "inspection",
            "calibration_certificate",
            "analysis",
            "other"
          ]
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "collection_context": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "value",
          "datatype",
          "fact_provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^param_[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "value": {
            "type": "number"
          },
          "datatype": {
            "enum": [
              "number"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "fact_provenance": {
            "type": "object",
            "required": [
              "category",
              "derived_from"
            ],
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": [
                  "computed_result",
                  "measured",
                  "ai_proposal",
                  "human_input"
                ]
              },
              "ai_agent_ref": {
                "type": "string"
              },
              "derived_from": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "string",
                  "pattern": "^attachment:att_[a-z0-9_]+$"
                },
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "fact_uncertainty": {
            "enum": [
              "verified",
              "requires_validation",
              "computed",
              "estimated"
            ]
          }
        }
      }
    },
    "attachment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../_shared/attachment_record.schema.json"
      }
    },
    "relationship": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
