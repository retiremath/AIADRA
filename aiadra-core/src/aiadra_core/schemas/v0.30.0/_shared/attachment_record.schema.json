{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attachment record shape (shared across Attachment-bearing Objects per ADR/0017 \u00a72 + \u00a78)",
  "type": "object",
  "required": [
    "id",
    "role",
    "media_type",
    "vault_path",
    "content_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^att_[a-z0-9_]+$"
    },
    "role": {
      "enum": [
        "source_authoring",
        "rendered_primary",
        "derived_secondary"
      ]
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "vault_path": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "derived_from_attachment_id": {
      "type": "string",
      "pattern": "^att_[a-z0-9_]+$"
    },
    "fact_provenance": {
      "type": "object",
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "human_input",
            "ai_proposal",
            "computed_result",
            "measured"
          ]
        },
        "ai_agent_ref": {
          "type": "string"
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fact_uncertainty": {
      "enum": [
        "verified",
        "requires_validation",
        "computed",
        "estimated"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "enum": [
              "rendered_primary",
              "derived_secondary"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "derived_from_attachment_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "source_authoring"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "not": {
          "required": [
            "derived_from_attachment_id"
          ]
        }
      }
    }
  ]
}
