{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement sidecar / Revision (Wedge-002 \u2014 widened per Codex1 B2 to allow cites)",
  "type": "object",
  "required": [
    "object",
    "requirement"
  ],
  "additionalProperties": false,
  "properties": {
    "object": {
      "type": "object",
      "required": [
        "uuid",
        "number",
        "type",
        "name",
        "lifecycle",
        "schema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "number": {
          "type": "string",
          "pattern": "^REQ-[0-9]{6}$"
        },
        "type": {
          "const": "Requirement"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": [
            "in_work",
            "released"
          ]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "fact_provenance": {
          "$ref": "#/$defs/fact_provenance"
        },
        "fact_uncertainty": {
          "$ref": "#/$defs/fact_uncertainty"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision_label": {
          "type": "string",
          "minLength": 1
        },
        "released_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "released"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "required": [
              "revision_id",
              "revision_label",
              "released_at"
            ]
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "required": [
        "statement",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "object",
          "required": [
            "text",
            "language",
            "format"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "minLength": 2
            },
            "format": {
              "enum": [
                "freeform",
                "ears"
              ]
            }
          }
        },
        "category": {
          "enum": [
            "functional",
            "performance",
            "non_functional",
            "interface",
            "design_constraint",
            "regulatory"
          ]
        },
        "default_verification_method": {
          "enum": [
            "test",
            "analysis",
            "inspection",
            "demonstration"
          ]
        }
      }
    },
    "acceptance_criterion": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ac_[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "object",
            "required": [
              "text",
              "language",
              "format"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "minLength": 2
              },
              "format": {
                "enum": [
                  "freeform",
                  "ears"
                ]
              }
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_method": {
            "enum": [
              "test",
              "analysis",
              "inspection",
              "demonstration"
            ]
          },
          "fact_provenance": {
            "$ref": "#/$defs/fact_provenance"
          },
          "fact_uncertainty": {
            "$ref": "#/$defs/fact_uncertainty"
          }
        }
      }
    },
    "relationship": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "../relationship/cites.schema.json"
          }
        ]
      }
    }
  },
  "$defs": {
    "fact_provenance": {
      "type": "object",
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "human_input",
            "ai_proposal",
            "computed_result",
            "measured"
          ]
        },
        "ai_agent_ref": {
          "type": "string"
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fact_uncertainty": {
      "enum": [
        "verified",
        "requires_validation",
        "computed",
        "estimated"
      ]
    }
  }
}
