{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Manifest (Wedge-002 \u2014 object_number pattern widened per Codex1 B4 for TST/TEX/EVD)",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "manifest_type",
    "release_label",
    "released_at",
    "revisions",
    "validation_outcomes",
    "event_log_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "artifact_kind": {
      "const": "manifest"
    },
    "manifest_type": {
      "const": "release"
    },
    "release_label": {
      "type": "string",
      "minLength": 1
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "object_uuid",
          "object_number",
          "revision_id",
          "revision_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "object_uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "object_number": {
            "type": "string",
            "pattern": "^(P|REQ|TST|TEX|EVD)-[0-9]{6}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "revision_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "validation_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_name",
          "result",
          "details"
        ],
        "additionalProperties": false,
        "properties": {
          "check_name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "event_log_boundary": {
      "type": "object",
      "required": [
        "last_event_id",
        "last_event_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "last_event_id": {
          "type": "string",
          "pattern": "^evt_[0-9]{4}$"
        },
        "last_event_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "stage_number": {
      "type": "integer",
      "minimum": 1,
      "description": "Per ADR/0025 sec.7 W1 absorption. 1 for single-stage; incrementing for multi-stage."
    },
    "prior_stage_manifest_ref": {
      "type": "object",
      "required": [
        "manifest_hash",
        "stage_number"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stage_number": {
          "type": "integer",
          "minimum": 1
        },
        "release_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Reference to prior stage in multi-stage chain. Absent on single-stage / first-stage."
    },
    "final_stage": {
      "type": "boolean",
      "description": "Per Codex2 N3 / Phase 1 B1 absorption. true => cross-graph validations must appear in validation_outcomes; false => cross-graph outcomes MUST be absent. Default true for backward-compat with v0.19.0 single-stage manifests."
    }
  }
}
